<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ghelperd</AssemblyName>
    <RootNamespace>GHelper.Daemon</RootNamespace>
    <Version>1.0.90-x13.1</Version>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <!-- Phase 2 supplies reviewable source and packaging assets only. The daemon
       cannot become a deployable Release artifact until the canonical wrapper
       explicitly learns how to attest and package it. -->
  <Target Name="RefuseUnattestedDaemonRelease" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(GHelperCanonicalDaemonBuild)' != 'true'"
           Text="UNATTESTED ghelperd Release publishing is disabled until the reviewed package phase." />
  </Target>
</Project>
